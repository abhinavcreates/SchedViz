# ─────────────────────────────────────────────────────────────────────────────
# SchedViz Server — Environment Variables
# Copy this file to .env and fill in your values before starting the server.
#
# REQUIRED variables (server will exit immediately if these are missing):
#   - MONGO_URI
#   - JWT_SECRET
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string.
# Get it from: Atlas Dashboard → Connect → Drivers → Node.js
# Replace <username>, <password>, and <cluster> with your actual values.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/schedviz?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret. Use a long (32+ chars) random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your frontend client. The API server will ONLY accept requests
# from this origin. Update this to your deployed frontend URL in production.
# In local development, leave as-is (Vite default port).
CLIENT_URL=http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── C++ Engine Path ───────────────────────────────────────────────────────────
# Path to the compiled engine binary, relative to server/src/utils/engine.js.
# On Linux/macOS/WSL: ../../engine/bin/schedviz_engine
# On Windows native (MinGW): ..\\..\\engine\\bin\\schedviz_engine.exe
ENGINE_PATH=../../engine/bin/schedviz_engine
